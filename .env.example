# Variables de Entorno del Sistema de Peaje Inteligente

# Base de Datos en la Nube (Supabase PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<tu-project-ref>
DB_PASSWORD=<tu-password>
DB_SSLMODE=require

# Endpoint Inferencia en RunPod (FastAPI M1 + M2 + M3)
INFERENCE_URL=https://<POD_ID>-8000.proxy.runpod.net

# Agente Conversacional LLM (Ollama en RunPod)
OLLAMA_URL=https://<POD_ID>-11434.proxy.runpod.net
OLLAMA_MODEL=llama3.2:3b

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend Vue
VITE_API_BASE_URL=https://peaje.tudominio.com/api/v1
