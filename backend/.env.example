APP_NAME="Peaje Inteligente"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://peaje.tudominio.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/app/backend/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://peaje.tudominio.com/api/v1/auth/google/callback

# Endpoint de Inferencia en RunPod (M1 + M2 + M3)
# Formato RunPod: https://<POD_ID>-8000.proxy.runpod.net
INFERENCE_URL=https://<POD_ID>-8000.proxy.runpod.net

# Motor de Agente Conversacional con Ollama en RunPod (+20 pts)
# Formato RunPod: https://<POD_ID>-11434.proxy.runpod.net o http://127.0.0.1:11434 si corre en el mismo host
OLLAMA_URL=https://<POD_ID>-11434.proxy.runpod.net
OLLAMA_MODEL=llama3.2:3b
